# Everything that runs on the Linux VM must have LF line endings.
* text=auto eol=lf
*.sh        text eol=lf
*.nft       text eol=lf
*.py        text eol=lf
*.md        text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
Dockerfile  text eol=lf
Caddyfile   text eol=lf
scripts/githooks/* text eol=lf
*.png binary
*.jpg binary
